POLARIS_LLM_API_KEY=sk-your-key-here
POLARIS_LLM_MODEL=openai/gpt-oss-120b
POLARIS_LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Free LLM providers (all OpenAI-compatible; swap these three lines) ---
# Groq (recommended, fastest; 30 req/min, 1000/day, free, no card)
#   base_url: https://api.groq.com/openai/v1
#   models:   openai/gpt-oss-120b | openai/gpt-oss-20b | qwen/qwen3-27b
# Google Gemini (OpenAI-compatible endpoint; free tier, generous)
#   base_url: https://generativelanguage.googleapis.com/v1beta/openai
#   models:   gemini-2.5-flash
# OpenRouter (router over many free models; 20 req/min, 50 req/day free)
#   base_url: https://openrouter.ai/api/v1
#   models:   openrouter/free | deepseek/deepseek-chat-v3-0324:free
# Original provider this project was built against:
#   base_url: https://api.deepseek.com/v1
#   models:   deepseek-chat

# Prometheus (optional; enriches RCA with real resource metrics)
POLARIS_METRICS_PROMETHEUS_ENABLED=false
POLARIS_METRICS_PROMETHEUS_URL=http://localhost:9090

# Alerting (optional; Slack-compatible webhook)
POLARIS_ALERTING_ENABLED=false
POLARIS_ALERTING_WEBHOOK_URL=

# Storage (optional; default sqlite at ./data/polaris.db)
# POLARIS_STORAGE_TYPE=postgres
# POLARIS_STORAGE_DSN=postgres://polaris:polaris@localhost:5432/polaris?sslmode=disable
